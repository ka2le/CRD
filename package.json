{
  "name": "crd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:check && vite build",
    "assets:prepare": "node scripts/prepare-images.mjs",
    "assets:check": "node scripts/prepare-images.mjs --check",
    "assets:smoke": "node scripts/image-smoke.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "headless:worker": "node scripts/headless-worker.mjs",
    "headless:smoke": "python python/random_headless_smoke.py",
    "headless:test": "node --test scripts/headless-tests.mjs",
    "regression:smoke": "node scripts/regression-smoke.mjs",
    "opponent:test": "node --test scripts/opponent-ai-tests.mjs",
    "tabletop:test": "node --test scripts/tabletop-tests.mjs",
    "opponent:benchmark": "node scripts/opponent-ai-benchmark.mjs",
    "testdeck:test": "node --test scripts/test-deck-tests.mjs",
    "rooms:test": "node --test scripts/room-tests.mjs",
    "relay:dev": "wrangler dev --config relay/wrangler.jsonc --var ALLOW_LOCAL_TESTING:true",
    "relay:login": "wrangler login",
    "relay:deploy": "wrangler deploy --config relay/wrangler.jsonc",
    "relay:secret": "wrangler secret put TURNSTILE_SECRET_KEY --config relay/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.5",
    "vite": "^8.0.12",
    "wrangler": "^4.151.3"
  }
}
